{
  "name": "ebitda-value-lever-simulator",
  "version": "2.0.0",
  "description": "UAE regional intelligence, market-entry and value-creation decision workspace.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "value-memo": "bin/value-memo.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "memo": "node bin/value-memo.js",
    "check": "npm test && npm run build && npm run bundle:check",
    "bundle:check": "node scripts/check-bundle.mjs",
    "pulse": "node scripts/fetch-pulse.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7"
  }
}
